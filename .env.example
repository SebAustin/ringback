# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=8080
# Public base URL of the deployed app (no trailing slash)
APP_BASE_URL=http://localhost:8080
# firestore | memory  (memory = local dev/demo without GCP credentials)
STORE=memory

# ── Google Cloud / Gemini ────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=learning-183922
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Set to 1 to use canned Gemini responses (local dev / CI without a key)
GEMINI_MOCK=

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=hello@example.com

# ── Auth & founder ───────────────────────────────────────────────────────────
# 32+ random bytes; `openssl rand -hex 32`
SESSION_SECRET=dev-secret-change-me-please-0000000000000000
FOUNDER_EMAIL=henry.sebastien1982@gmail.com
FOUNDER_PHONE=
DEMO_TENANT_ID=demo-luxe-cuts

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Places API key for the Prospector agent
PLACES_API_KEY=
