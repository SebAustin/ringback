{
  "name": "ringback",
  "version": "0.1.0",
  "private": true,
  "description": "RingBack — AI receptionist for local businesses. Missed-call textback, Gemini-powered SMS conversations, bookings, and an AI operations layer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed-demo-tenant.ts",
    "simulate": "tsx scripts/simulate-missed-call.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@google/genai": "^1.9.0",
    "fastify": "^5.3.2",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "stripe": "^18.2.1",
    "twilio": "^5.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8"
  }
}
